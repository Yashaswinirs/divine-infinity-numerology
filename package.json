{
  "name": "divine-infinity-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:student": "pnpm --filter @divine/student dev",
    "dev:admin": "pnpm --filter @divine/admin dev",
    "dev:server": "pnpm --filter @divine/server dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:student": "pnpm --filter @divine/student build",
    "build:admin": "pnpm --filter @divine/admin build",
    "build:server": "pnpm --filter @divine/server build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.4.4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bcryptjs"
    ]
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
